# --- The DID host -------------------------------------------------------------
# The domain it is at, which is part of every address it hands out
# (did:web:id.example:alice). It can't be changed afterwards.
DID_HOST_DOMAIN=id.example
# The DIDs that decide who may claim a reserved name (official:*, admin, ...),
# separated by commas. An admin's DID is the one their app shows as their ID.
DID_HOST_ADMINS=
# Its database: one of its own, shared with no other service.
# A password with anything but letters and digits in it is percent-encoded (@ is %40).
# `host.docker.internal` is this machine, for a database server running on it.
DID_HOST_DATABASE_URL=mysql://wyvrn:password@host.docker.internal:3306/wyvrn_did_host

# --- The sticker service ------------------------------------------------------
# Its domain is part of every pack's address, and can't be changed afterwards.
STICKERS_DOMAIN=stickers.example
# The DIDs that may take a pack down, separated by commas.
STICKERS_ADMINS=
STICKERS_DATABASE_URL=mysql://wyvrn:password@host.docker.internal:3306/wyvrn_stickers

# --- A community server (docker compose --profile community) --------------------
# COMMUNITY_DOMAIN=community.example
# COMMUNITY_NAME=A community
# Nobody is let in until someone is named here (DIDs, separated by commas: the
# DID an app writes from, or someone's public address).
# COMMUNITY_ADMINS=
# COMMUNITY_MEMBERS=
# COMMUNITY_DATABASE_URL=mysql://wyvrn:password@host.docker.internal:3306/wyvrn_community
# An address for it at the DID host, under community: (claimed by the community
# itself; the host asks it first whether it is a community server):
# COMMUNITY_PUBLIC_ADDRESS=did:web:id.example:community:makers

# --- An announcement channel (docker compose --profile announce) ---------------
# ANNOUNCE_DOMAIN=updates.example
# ANNOUNCE_NAME=Announcements
# ANNOUNCE_DESCRIPTION=A one-way announcement channel.
# The DIDs that may post, separated by commas: the DID an app writes from, or
# someone's public address (did:webvh:…:id.example:alice).
# ANNOUNCE_ADMINS=
# ANNOUNCE_DATABASE_URL=mysql://wyvrn:password@host.docker.internal:3306/wyvrn_announce
# An address for it at the DID host, to be known by (../../README.md, "A public
# address for a service"). An "official:" name is set aside for it first:
#   wyvrn-did-host assign official:update-news did:web:updates.example
# ANNOUNCE_PUBLIC_ADDRESS=did:web:id.example:official:update-news

# --- A files service (docker compose --profile files) --------------------------
# Its domain is part of every file's address, and can't be changed afterwards.
# FILES_DOMAIN=files.example
# Who may put files here, separated by commas: the DID an agent writes from, or
# a public address at the DID host (matched by the key its holder writes with).
# FILES_UPLOADERS=did:web:id.example:frosty:claude
# Who runs it: its admin pages, in the app, are theirs alone.
# FILES_ADMINS=did:web:id.example:frosty
# Anyone who authenticates may become an uploader (an admin can lock this down).
# FILES_OPEN_SIGNUP=false
# How much each may keep, in bytes (10 GiB). The largest file is 4 GiB.
# FILES_QUOTA_BYTES=10737418240
# FILES_DATABASE_URL=mysql://wyvrn:password@host.docker.internal:3306/wyvrn_files
# An "official:" name set aside for it first:
#   wyvrn-did-host assign official:files did:web:files.example
# FILES_PUBLIC_ADDRESS=did:web:id.example:official:files

# --- Link cards (docker compose --profile cards) --------------------------------
# What a link to an address looks like where it is posted. No database.
# The domains whose own did:web it marks Official: what the app is built with
# (VITE_OFFICIAL_DOMAINS). Unset, DID_HOST_DOMAIN alone.
# CARDS_OFFICIAL_DOMAINS=id.example,stickers.example,updates.example
# CARDS_SITE_NAME=Wyvrn
# The web app's address, if the pages come out naming it wrongly (http://, or
# another host): TLS ended before the proxy that passes requests here.
# CARDS_PUBLIC_URL=https://chat.example

# --- An outbound relay (docker compose --profile relay) ------------------------
# Its domain, which its DID is made of (did:web:relay.example).
# RELAY_DOMAIN=relay.example
# What it carries: all (messages, collecting and live delivery) or sends.
# RELAY_CARRIES=all
# Anyone may register (true), or only the DIDs in RELAY_CLIENTS, separated by commas.
# RELAY_OPEN=true
# RELAY_CLIENTS=
# Hosts it may reach although they are private (this machine, a Docker network):
# a mediator it can only reach from beside it. Nothing private otherwise.
# RELAY_ALLOW=
# RELAY_DATABASE_URL=mysql://wyvrn:password@host.docker.internal:3306/wyvrn_relay

# --- Where each listens on this machine, for the web server in front ------------
# DID_HOST_PORT=8181
# STICKERS_PORT=8182
# COMMUNITY_PORT=8183
# ANNOUNCE_PORT=8184
# CARDS_PORT=8185
# FILES_PORT=8186
# RELAY_PORT=8187
