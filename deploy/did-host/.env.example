# The domain the host is at, and that appears in every DID it hosts:
# did:web:id.example:alice is fetched from https://id.example/alice/did.json.
# Its DNS has to point at this machine before the first start.
# It can't be changed afterwards without breaking every DID already handed out.
DID_HOST_DOMAIN=id.example

# The DIDs that decide who may claim a reserved name (official:*, admin, ...),
# separated by commas. An admin's DID is the one their app shows as their ID.
DID_HOST_ADMINS=

# Only for trying the setup on a machine that isn't at the domain:
# DID_HOST_TLS=internal
# HTTP_PORT=8080
# HTTPS_PORT=8443
